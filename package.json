{
  "name": "cbrl-toolkit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint *.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:package": "turbo run check:package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build check:package && changeset publish",
    "prepare": "node .husky/install.mjs"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "prettier": "@cbrl/prettier-config",
  "devDependencies": {
    "@cbrl/commitlint-config": "workspace:*",
    "@cbrl/eslint-config": "workspace:*",
    "@cbrl/prettier-config": "workspace:*",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "catalog:",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "protobufjs"
    ],
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
    }
  }
}
