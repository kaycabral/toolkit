{
  "name": "@cbrl/pg",
  "version": "0.3.0",
  "description": "Hardened node-postgres pool factory (bounded timeouts, idle-error handler, process-wide registry, Supabase CA pinning), Postgres error helpers and an optional Drizzle integration.",
  "license": "MIT",
  "author": "Kayron Cabral",
  "homepage": "https://github.com/kaycabral/toolkit/tree/main/packages/pg#readme",
  "bugs": {
    "url": "https://github.com/kaycabral/toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaycabral/toolkit.git",
    "directory": "packages/pg"
  },
  "keywords": [
    "postgres",
    "pg",
    "pool",
    "supabase",
    "drizzle"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./drizzle": "./dist/drizzle.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check:package": "node ../../scripts/check-package.mjs --types",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cbrl/env": "workspace:^",
    "@types/pg": "^8.20.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44.0 <1",
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@cbrl/eslint-config": "workspace:*",
    "@cbrl/testing": "workspace:*",
    "@cbrl/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
