{
  "name": "@cbrl/next",
  "version": "0.1.1",
  "description": "Next.js 16 building blocks: security headers with a reporting CSP, commit SHA, dev origins, health and CSP-report route handlers, safeNext.",
  "license": "MIT",
  "author": "Kayron Cabral",
  "homepage": "https://github.com/kaycabral/toolkit/tree/main/packages/next#readme",
  "bugs": {
    "url": "https://github.com/kaycabral/toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaycabral/toolkit.git",
    "directory": "packages/next"
  },
  "keywords": [
    "next",
    "nextjs",
    "csp",
    "security-headers",
    "health-check"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
