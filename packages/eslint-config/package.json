{
  "name": "@cbrl/eslint-base",
  "version": "0.4.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Canonical ESLint flat config shared by every app/package in the cbrl monorepo. Consumed via `import` in workspace `eslint.config.mjs`.",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "scripts": {
    "test": "node --test rules/*.test.mjs"
  },
  "files": [
    "index.mjs",
    "globs.mjs",
    "plugin.mjs",
    "configs/",
    "rules/"
  ],
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-testing-library": "^7.13.1",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.59.3"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "eslint-plugin-boundaries": "^6.0.2"
  }
}
