{
  "name": "@cbrl/eslint-config",
  "version": "0.1.0",
  "description": "Strict ESLint flat config for TypeScript, React and Next.js apps, with custom fail-fast rules (no eslint-disable, no env fallbacks).",
  "license": "MIT",
  "author": "Kayron Cabral",
  "homepage": "https://github.com/kaycabral/toolkit/tree/main/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/kaycabral/toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaycabral/toolkit.git",
    "directory": "packages/eslint-config"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "typescript",
    "nextjs"
  ],
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./plugin": "./plugin.mjs",
    "./globs": "./globs.mjs"
  },
  "files": [
    "index.mjs",
    "globs.mjs",
    "plugin.mjs",
    "configs/",
    "rules/*.mjs",
    "!rules/*.test.mjs"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "node --test rules/*.test.mjs",
    "check:package": "node ../../scripts/check-package.mjs"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-testing-library": "^7.13.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.59.3"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=5.0.0 <7"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
