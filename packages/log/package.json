{
  "name": "@cbrl/log",
  "version": "0.1.0",
  "description": "PII-safe structured logger (JSON lines with Cloud Logging severity) and per-request correlation context on AsyncLocalStorage.",
  "license": "MIT",
  "author": "Kayron Cabral",
  "homepage": "https://github.com/kaycabral/toolkit/tree/main/packages/log#readme",
  "bugs": {
    "url": "https://github.com/kaycabral/toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaycabral/toolkit.git",
    "directory": "packages/log"
  },
  "keywords": [
    "logger",
    "logging",
    "structured-logging",
    "pii",
    "lgpd",
    "correlation-id",
    "async-local-storage"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check:package": "node ../../scripts/check-package.mjs --types",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@cbrl/eslint-config": "workspace:*",
    "@cbrl/testing": "workspace:*",
    "@cbrl/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
