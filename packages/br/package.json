{
  "name": "@cbrl/br",
  "version": "0.0.0",
  "description": "Framework-free Brazilian domain utilities: phone and WhatsApp links, BRL money, CPF/CNPJ and CEP with a BrasilAPI lookup.",
  "license": "MIT",
  "author": "Kayron Cabral",
  "homepage": "https://github.com/kaycabral/toolkit/tree/main/packages/br#readme",
  "bugs": {
    "url": "https://github.com/kaycabral/toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaycabral/toolkit.git",
    "directory": "packages/br"
  },
  "keywords": [
    "brazil",
    "brasil",
    "phone",
    "whatsapp",
    "brl",
    "cpf",
    "cnpj",
    "cep",
    "brasilapi"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./money": "./dist/money.js",
    "./phone": "./dist/phone.js",
    "./postal-code": "./dist/postal-code.js",
    "./tax-id": "./dist/tax-id.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check:package": "node ../../scripts/check-package.mjs --types",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@cbrl/eslint-config": "workspace:*",
    "@cbrl/testing": "workspace:*",
    "@cbrl/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
