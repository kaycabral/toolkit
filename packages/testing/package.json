{
  "name": "@cbrl/testing",
  "version": "0.3.0",
  "description": "Test helpers: Vitest coverage base, server-only shim, jsdom polyfills, jest-axe a11y matcher, and Playwright E2E/smoke presets.",
  "license": "MIT",
  "author": "Kayron Cabral",
  "homepage": "https://github.com/kaycabral/toolkit/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/kaycabral/toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaycabral/toolkit.git",
    "directory": "packages/testing"
  },
  "keywords": [
    "vitest",
    "playwright",
    "testing",
    "coverage",
    "a11y",
    "jest-axe"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./a11y": "./dist/a11y.mjs",
    "./playwright": "./dist/playwright.mjs",
    "./vitest": "./dist/vitest.mjs",
    "./vitest/jsdom": "./dist/vitest/jsdom.mjs",
    "./vitest/server-only-shim": "./dist/vitest/server-only-shim.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check:package": "node ../../scripts/check-package.mjs --types",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cbrl/env": "workspace:^",
    "jest-axe": "^10.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50",
    "vitest": ">=3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@cbrl/eslint-config": "workspace:*",
    "@cbrl/tsconfig": "workspace:*",
    "@playwright/test": "^1.56.1",
    "@types/jest-axe": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
